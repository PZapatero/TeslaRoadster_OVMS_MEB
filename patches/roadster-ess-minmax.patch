+void OvmsVehicleTeslaRoadster::IncomingFrameCan3(CAN_frame_t* p_frame)
+  {
+  OvmsRecMutexLock lock(&m_ess_mutex);
+  if (m_ess_minmax.Decode(p_frame->MsgID, p_frame->data.u8, p_frame->FIR.B.DLC,
+      p_frame->FIR.B.FF != CAN_frame_std, p_frame->FIR.B.RTR != 0, monotonictime))
+    UpdateEssMinMax();
+  }
+
+void OvmsVehicleTeslaRoadster::UpdateEssMinMax()
+  {
+  OvmsRecMutexLock lock(&m_ess_mutex);
+  float min, max;
+  const bool voltage_valid = m_ess_minmax.Voltage(monotonictime, min, max);
+  m_ess_voltage_valid->SetValue(voltage_valid);
+  if (voltage_valid)
+    {
+    StandardMetrics.ms_v_bat_pack_vmin->SetValue(min, Volts);
+    StandardMetrics.ms_v_bat_pack_vmax->SetValue(max, Volts);
+    }
+  else
+    {
+    if (StandardMetrics.ms_v_bat_pack_vmin->IsDefined()) StandardMetrics.ms_v_bat_pack_vmin->Clear();
+    if (StandardMetrics.ms_v_bat_pack_vmax->IsDefined()) StandardMetrics.ms_v_bat_pack_vmax->Clear();
+    }
+  const bool temperature_valid = m_ess_minmax.Temperature(monotonictime, min, max);
+  m_ess_temperature_valid->SetValue(temperature_valid);
+  if (temperature_valid)
+    {
+    StandardMetrics.ms_v_bat_pack_tmin->SetValue(min, Celcius);
+    StandardMetrics.ms_v_bat_pack_tmax->SetValue(max, Celcius);
+    }
+  else
+    {
+    if (StandardMetrics.ms_v_bat_pack_tmin->IsDefined()) StandardMetrics.ms_v_bat_pack_tmin->Clear();
+    if (StandardMetrics.ms_v_bat_pack_tmax->IsDefined()) StandardMetrics.ms_v_bat_pack_tmax->Clear();
+    }
+  }
+
